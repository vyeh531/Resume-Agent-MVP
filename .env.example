# Copy this file to .env.local and fill in values only on the machine running the app.
# Do not commit or share real secrets.

# Optional. When set, reports are persisted in Postgres/Supabase.
# When omitted, the app can still run a same-session demo with in-memory report storage.
DATABASE_URL=

# Optional hosted ATS service. If missing/unavailable, the app uses local ATS fallback.
ATS_API_URL=https://ats-system-wec6.onrender.com/api/v1/score
ATS_API_KEY=

# Optional AI key for mentor-advice API routes that call Anthropic directly.
ANTHROPIC_API_KEY=

# Local/dev toggles
DEV_UNLOCK_REPORTS=false
PAYMENT_MOCK_ENABLED=true
DEBUG_REPORT_SECRET=
LOG_ATS_PUBLIC_RESPONSE=false
LOG_ATS_RETRIEVAL_DEBUG=false
MENTOR_RETRIEVAL_TIMING=false
MENTOR_RETRIEVAL_DEBUG_COUNTS=false
MENTOR_RETRIEVAL_SQL_LIMIT=800
